      "self_grasping": [
        {
          "id": "sg_f1",
          "text": "沈川把与交往多年的女友结婚这一婚姻选择当成属于自己人生安排、不能由父亲以两家家庭条件和生活方式差异来否定或要求重新考虑的部分。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f2",
          "text": "沈川把‘婚姻由我自己决定’的自主位置当成与自己不可分，父亲明确反对并几次劝他重新考虑，正触到这个边界。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f3",
          "text": "沈川把女友，尤其在她第一次正式来家里吃饭后仍未被父亲接纳时，当成‘我这边’的人、自己未来生活的一部分，而不是可以被父亲按两家差异重新评估的对象。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f4",
          "text": "沈川把‘我和她结婚’这一判断当成自己正确性的延伸，不能接受父亲用‘结婚选错了不是这么简单’把它放进‘选错’框架来要求重审。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        }
      ],
      "dharma_grasping": [
        {
          "id": "dg_f1",
          "text": "沈川持这样的理解：婚姻应以两个人交往与感情本身为基础，家庭条件和生活方式差异不应成为否决或要求重新考虑的理由。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "dg_f2",
          "text": "沈川持这样的理解：成年子女的婚姻选择权在子女本人，父母至多给建议，不应明确反对或反复劝其重新考虑；父亲现在的做法越过了这条界线。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "dg_f4",
          "text": "沈川持这样的理解：交往多年已经构成足够依据，这段关系理应顺理成章走向结婚，不应因父亲的‘选错’警告被推翻。",
          "confidence": 0.75,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "dg_f5",
          "text": "沈川持这样的理解：婚姻不是像工作那样可以按风险比较、选错再换的选项，父亲用‘工作选错了还能换，结婚选错了不是这么简单’来衡量我和女友的婚姻，这套框架本身就不适用。",
          "confidence": 0.75,
