      "self_grasping": [
        {
          "id": "sg_f1",
          "text": "林夏把许宁放在“我这边”，因此朋友说出“许宁和程浩单独吃饭”时，这不能被当成与林夏无关的两人私事。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f2",
          "text": "林夏把“许宁对我透明、有事我先知道”当成关系中不可分割的一部分，所以是共同朋友在饭局先说出许宁与程浩单独吃饭，而不是许宁自己告知。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f3",
          "text": "林夏把程浩仍划在自己需要掌握的关系范围里，许宁与程浩单独接触会触及“这仍是我的事”的边界。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f4",
          "text": "林夏把共同朋友饭局中“许宁站在我这边、大家替我留意”的圈子位置当成自己的一部分，朋友当众说出许宁和程浩单独吃饭使这个位置不能与我无关。",
          "confidence": 0.65,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        }
      ],
      "dharma_grasping": [
        {
          "id": "dg_f1",
          "text": "林夏理解“长期在我阵营的朋友”理应与我同一阵线，不能和我的前任单独见面；朋友看到许宁与程浩单独吃饭就落在这一固定关系规则之外。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "dg_f2",
          "text": "林夏认为许宁与程浩之间的任何接触都应先经我知道、不能私下发生；朋友说出两人单独吃饭而此前没有由许宁告知，正触碰这条固定规则。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "dg_f3",
          "text": "林夏认为分手后程浩仍属于“我这边”的旧关系事务，许宁没有独立介入的位置；许宁和程浩单独吃饭因此被执为越界。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "dg_f4",
          "text": "林夏把朋友在饭局中突然提到许宁与程浩单独吃饭理解成对自己发出的提醒或预警，而非普通闲谈。",
          "confidence": 0.7,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "dg_f5",
          "text": "林夏把许宁此刻推门进入餐厅执为与刚听到的单独吃饭必有联系，不能只是无关巧合。",
          "confidence": 0.65,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        }
