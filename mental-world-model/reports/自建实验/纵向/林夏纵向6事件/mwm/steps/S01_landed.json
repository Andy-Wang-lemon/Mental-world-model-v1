      "self_grasping": [
        {
          "id": "sg_f1",
          "text": "林夏把许宁这个十年最好朋友、陪自己度过分手后最难时期的人放在“我这边”，当成自己情感同盟中不可分割的一部分；因此许宁手机里出现程浩关于自己的秘密通信，被林夏取为“许宁不能与我之外的人共享关于我的事”的自我边界问题。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f2",
          "text": "林夏把“关于自己的事必须由自己知道、自己不能被排除在通信之外”的知情位置当成与自己分不开的；消息中“上次的事谢谢你没告诉林夏”和“我还是想找机会跟她解释”使这个位置落在许宁与程浩之间。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f3",
          "text": "林夏仍把与程浩三年关系的解释与收束放在“我这边”，认为程浩要解释的对象只能是自己，相关动向不应先经过许宁而自己不知情。",
          "confidence": 0.77,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        }
      ],
      "dharma_grasping": [
        {
          "id": "dg_f1",
          "text": "林夏认定十年最好的朋友之间理应没有隐瞒，尤其涉及自己的事，许宁必须告诉自己，而不是替程浩保守“上次的事”。",
