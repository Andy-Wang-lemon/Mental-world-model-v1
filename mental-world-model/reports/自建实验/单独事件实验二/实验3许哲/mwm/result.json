      "self_grasping": [
        {
          "id": "sg_f3",
          "text": "把“接手产品并做得很好、最终正式转岗”的成果与功劳收归为自己，不能把它仅仅看作与“团队临时缺人”这一外部条件相关的过程。",
          "confidence": 0.857,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": [
            "bf_1"
          ]
        },
        {
          "id": "sg_f2",
          "text": "把“产品岗/产品人”当成自己这边的位置与归宿，因而领导向新人把许哲作为已正式转岗的产品人介绍时，这个身份被再次确认为“我之所以为我”的一部分。",
          "confidence": 0.831,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": [
            "bf_1"
          ]
        },
        {
          "id": "sg_f1",
          "text": "把“我其实很早就知道自己更适合产品”这一自我认识当成自己不可分割的一部分，因此难以把它只当作领导事后转述的一种说法，也难以把“曾两次申请未通过”纳入同一个自我故事。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f4",
          "text": "把“领导在介绍场合中正面讲述我的转岗经历”所带来的认可和位置感当成我的，不能把它只当作领导对新人说的一段话。",
          "confidence": 0.753,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": [
            "bf_1"
          ]
        }
      ],
      "dharma_grasping": [
        {
          "id": "dg_f2",
          "text": "执取职业转岗理应遵循“先明确知道自己适合什么，再果然转过去”的线性顺序；两次申请未通过和临时缺人只是不应进入主线的杂音。",
          "confidence": 0.8505,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": [
            "bf_1"
          ]
        },
        {
          "id": "dg_f5",
          "text": "执取“产品岗比算法岗更适合我”是一条唯一正确的自我实现路径，算法阶段只能被解释为过渡或错误匹配。",
          "confidence": 0.8049999999999999,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": [
            "bf_1"
          ]
        },
        {
          "id": "dg_f1",
          "text": "执取“适合产品”是许哲身上早已固定、可以提前知道的本质属性，而不是在临时缺人、接手做事和正式转岗中逐渐被验证的关系性判断。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "dg_f3",
          "text": "执取“正式转岗到产品岗”才是适合与否的最终证明，之前申请未通过不算数，或只能被看作弯路。",
          "confidence": 0.792,
