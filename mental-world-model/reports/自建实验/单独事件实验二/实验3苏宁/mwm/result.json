      "self_grasping": [
        {
          "id": "sg_f1",
          "text": "苏宁可能把当年没有出国这一决定和为此留下的代价，当成自己不可分割的一部分；母亲说“当时幸好没去”时，这个决定仍被放在“我这边”，不能当成与己无关或只是当时条件下的安排。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f2",
          "text": "苏宁可能把未实现的留学机会、那个本可能去成的自己，仍当成自我的一部分；饭桌上一聊到留学，母亲又说幸好没去，这个未完成的可能性就更难被当作与现在的自己无关。",
          "confidence": 0.7,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f3",
          "text": "苏宁可能把现在的工作和两次升职当成自我价值不可分的确证；母亲用“你现在不是也挺好吗”来评价时，这些成就会被拉进自我核心，必须被放进对“我”的认定里。",
          "confidence": 0.7,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "sg_f4",
          "text": "苏宁可能把“为家里留下、承担家里需要”的位置当成自己的一部分；母亲说“幸好没去”时，这个位置是否被承认、是否只是被轻描淡写地肯定，会牵动她难以把这段经历看作与己无关。",
          "confidence": 0.55,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        }
      ],
      "dharma_grasping": [
        {
          "id": "dg_f1",
          "text": "苏宁可能执成一种固定理解：人生选择的对错不能由后来“也挺好”的结果来倒推；母亲说“幸好没去，不然哪有现在这些”是在用结果反证选择，这种归因方式本身就不该成立。",
          "confidence": 0.8,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
          "id": "dg_f2",
          "text": "苏宁可能执成“出国留学才是原本更该走、更接近自我实现的路”；母亲把没去说成“幸好”，与这个固定理解相冲突，使她难以接受这种对留学价值的重新排序。",
          "confidence": 0.7,
          "source": "推理",
          "source_type": "fresh",
          "source_bias_frame_ids": []
        },
        {
