# 复制为 .env 并填入你的 LLM 服务配置（.env 已在 .gitignore 中）

# DeepSeek 示例
MWM_LLM_BASE_URL=https://api.deepseek.com
MWM_LLM_MODEL=deepseek-v4-flash
MWM_LLM_API_KEY=your-api-key-here

# 可选
# MWM_LLM_CHAT_PATH=/chat/completions
# MWM_LLM_JSON_RESPONSE=true
# 并行与连接池（默认 160：同一评分波内全部心所×最多 4 支；四列仍分波）
# MWM_LLM_PARALLEL=1
# MWM_LLM_MAX_CONCURRENCY=160
# MWM_LLM_POOL_SIZE=160
# 进度日志（默认开，打到 stderr；关闭设 0）
# MWM_LLM_PROGRESS=1
# 解码稳定性（默认 temperature=0 / top_p=1 / seed=42；SEED 置空则不传）
# MWM_LLM_TEMPERATURE=0
# MWM_LLM_TOP_P=1
# MWM_LLM_SEED=42
